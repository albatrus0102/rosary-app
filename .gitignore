# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

android/.gradle/
*.apk

# 스테인드글라스 고해상도 원본(저장소에는 올리지 않는다; 앱에 넣는 최종 파일만 커밋)
assets/church/glass_src/*_orig.*

# 십자가의 길 연작 원본(내려받은 파일; tools/stations/fetch_series.py 로 다시 받는다)
art/stations_series/

# Claude Code agent worktrees
.claude/worktrees/
# 개발용 임시 유리의 부하 시험용 리샘플 팩(tools/glass_bundle/devglass_pack.py --resample; 원본 팩 gpack_dev_*.js 는 커밋한다)
assets/church/dev/gpack_devrs_*.js

# 도구 의존성(npm install 로 복원)
tools/**/node_modules/

# 위키미디어 원본(대용량, 저장소 밖 보관)
art/commons_handoff/originals/
art/commons_handoff/*.part
art/commons_handoff/received/

# 성가 녹음 원본(커먼즈에서 받은 것; 앱에는 줄인 assets/music/*.m4a 만 넣는다)
art/music_handoff/originals/
art/music_handoff/received/
art/music_handoff/*.part

# Meshy 성모상 원본 glb(16.9MB) — 저장소에 올리지 않는다(docs/church/ASSET_LICENSES.md). 배포용 판은 assets/church/statue3d_mary_meshy.js
art/statues/meshy/*.glb

# 성상 3D 원본(SMK·Zenodo·스케치팹에서 받은 것; 저장소에는 올리지 않는다 — art/statue_handoff/manifest.json)
art/statue_handoff/received/
art/statue_handoff/*.part

# 웹 데모의 비밀 링크 대응표(받는 곳 id -> 토큰). 절대 올리지 않는다.
/web_demo/links.local.json

# Kotlin 빌드 캐시(Gradle이 빌드 중에 만든다)
/android/.kotlin/
