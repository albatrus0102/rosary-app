 const rows = [];
 for (const c of churches) {
+  // 14처 판을 걸지 않는 성당(crossWay.none — 아시시: 실제 벽이 벽화로 덮여 있고 판 자리가 확인되지 않음): 판 없음 + 이유 'none'
