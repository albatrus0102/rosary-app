+  assert.match(src, /ud\.triUsers = \(ud\.triUsers \|\| 1\) - 1; if \(ud\.triUsers <= 0\) ud\.triIds = null;/);
+  assert.match(g, /ud\.triUsers = \(ud\.triUsers \|\| 1\) - 1; if \(ud\.triUsers <= 0\) ud\.triIds = null;/);
